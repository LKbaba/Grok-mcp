    "ai",
    "llm",
    "claude-code",
    "claude-desktop",
    "typescript"
  ],
  "author": "LKbaba",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LKbaba/Grok-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/LKbaba/Grok-mcp/issues"
  },
  "homepage": "https://github.com/LKbaba/Grok-mcp#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
